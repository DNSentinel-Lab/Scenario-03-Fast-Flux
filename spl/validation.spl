/* Validate benign lookup */
| inputlookup fastflux_benign_domains.csv
| table query_name reason

/* Validate final detection output contract */
index=dns_soc_aws sourcetype=aws:s3 earliest=-30m
| spath
| rename answers{}.Rdata as answer_ip
| where query_type="A" AND rcode="NOERROR" AND isnotnull(answer_ip)
| eval query_name=lower(rtrim(query_name,"."))
| mvexpand answer_ip
| eval bucket=_time
| bin bucket span=5m
| fields bucket query_name answer_ip
| dedup bucket query_name answer_ip
| join type=inner max=0 bucket answer_ip [
    search index=dns_soc_aws sourcetype=aws:cloudwatchlogs:vpcflow earliest=-30m src_ip="10.50.30.20"
    | where NOT cidrmatch("10.0.0.0/8",dest_ip) AND NOT cidrmatch("172.16.0.0/12",dest_ip) AND NOT cidrmatch("192.168.0.0/16",dest_ip)
    | eval bucket=_time
    | bin bucket span=5m
    | rename dest_ip as answer_ip
    | fields bucket src_ip answer_ip
]
| stats count as matched_connections dc(answer_ip) as unique_matched_ips values(answer_ip) as matched_ips by bucket query_name src_ip
| where unique_matched_ips>=2 AND matched_connections>=3
| lookup fastflux_benign_domains.csv query_name OUTPUT reason as benign_reason
| eval validation_result=if(isnull(benign_reason),"WOULD DETECT","TUNED BENIGN")
| table bucket query_name src_ip matched_connections unique_matched_ips matched_ips benign_reason validation_result
| sort bucket
